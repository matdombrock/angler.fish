#! /usr/bin/env fish

# Prints a random fish name and description
# Usage:
#   source fish.fish
#   fishfish
# Use `--no-greet` to supress the greeting graphics

# The fish list is sourced from Wikipedia
# So all fish names are real
# Descriptions are generated by LLM and may be nonsensical or inaccurate

# TODO: Just read one line from the file it will be WAY faster
# loading the entire file is slow

set here (path dirname (realpath (status filename)))
set fish_list (cat $here/fishlist.txt)

set greeting_art "\
                               X         
 XXXXXX XX XXXXXX XX  XX      XX         
 XX     XX XX     XX  XX    XXXXXX       
 XXXXX  XX XXXXXX XXXXXX  XXXXXXXXXXX  X 
 XX     XX     XX XX  XX XX  XXXXXXXXXX  
 XX     XX XXXXXX XX  XX  XXXXXXXXXXX  X 
                               X         
"

function greet_echo
    set -l pos $argv[1]
    set -l fg '▓'
    # set -l bg '░'
    set -l bg '~'

    set width (tput cols)
    if test $width -lt 40
        return
    end
    set art_width 41
    set padding (math floor (math "($width - $art_width) / 2"))
    for i in (seq $padding)
        echo -n $bg
    end

    echo -n $greeting_art | string split \n | sed -n $pos | sed -e "s/X/$fg/g" -e "s/ /$bg/g" | tr \n x | sed -e s/x//g

    for i in (seq $padding)
        echo -n $bg
    end
    # If padding * 2 + art_width < width, add one more space
    if test (math "$padding * 2 + $art_width") != $width
        echo -n $bg
    end
    echo
end

function greet
    # Colored ASCII greeting
    set_color red
    greet_echo 1p
    set_color yellow
    greet_echo 2p
    set_color green
    greet_echo 3p
    set_color magenta
    greet_echo 4p
    set_color blue
    greet_echo 5p
    greet_echo 6p
    greet_echo 7p
end

function get_fish
    echo -n $fish_list | sed -n "$argv[1]{p}" | string split "|" | sed -n $argv[2] | string trim
end

function fishfish
    if test (count $argv) -eq 0; or not test "$argv[1]" = --no-greet
        greet
    end
    set -l lines (echo $fish_list | wc -l)
    set -l rand (math "1 + ($(random) % $lines)")
    set_color bryellow
    echo -n "🐟 "
    set_color brgreen
    get_fish $rand 1p
    set_color bryellow
    echo -n "🐟 "
    set_color brcyan
    get_fish $rand 2p
    set_color normal
end

fishfish

complete -c fishfish -f -a --no-greet -d "Skip ASCII greeting"
