set here (path dirname (realpath (status filename)))
source $here/lib/core.fish

# Convert a single cmd file
function convert
    set lines (cat $argv[1])
    set opth "$argv[2]"
    set opth (path change-extension ".fish" $opth)
    set tab "    "
    set cmdname
    set desc
    set params
    set paramsfull
    set reqs
    set code
    # Extract
    for line in $lines
        if test -z "$line"
            continue
        end
        if string match -q "# *" "$line" # cmdname
            set cmdname (string replace "# " "" $line)
        else if string match -q "\$*" "$line" # params
            set -l param (string split " " $line)[1]
            set params $params $param
            set paramsfull "$paramsfull:$line"
        else if string match -q "!*" "$line" # reqs
            set -l req (string trim (string replace "!" "" "$line")) 
            set reqs $reqs $req
        else if string match -q "`*" "$line" # code
            set code (string replace -a "`" "" $line)
        else # desc
            set desc $line
        end
    end
    # Construct fn string
    set -l fn "# Generated by angler.fish (do not edit)\n"
    set -l fn $fn"set ANG ~/.config/fish/functions/:ang\n"
    set -l fn $fn"source \$ANG/lib/core.fish\n\n"
    set -l fn $fn"function :$cmdname\n"
    for req in $reqs
        set fn $fn$tab"if not ensure \"$req\"; return; end\n"
    end
    set -l i 1
    for param in $params
        set param (string replace "\$" "" $param)
        set fn $fn$tab"set $param (param $param \$argv[$i])\n"
        set i (math $i + 1)
    end
    set -l fn $fn$tab"if test \"\$ANG_ECHO\" = 1\n"
    # set -l fn $fn$tab$tab"echo \"$code\"\n"
    set -l fn $fn$tab$tab"echo $code\n" # no quotes needed
    set -l fn $fn$tab"else\n"
    set -l fn $fn$tab$tab"$code\n"
    set -l fn $fn$tab"end\n"
    set -l fn $fn"end"
    # Write
    set opth (string replace ".cmd.fish" ".fish" "$bdir/:$cmdname.fish")
    echo -e "$fn" >$opth
    echo ":$cmdname|$desc|$paramsfull" >>$bdir/:ang/docs.md
end

# Build all cmds in given dir
function buildcmds
    # Run through the dir 
    set dir $argv[1]
    set lst (fd --type f --no-ignore . $dir)
    set i 0
    for file in $lst
        set basename (path basename $file)
        set opth
        if string match -q "*cmd.md" "$file" = .md
            set opth "$bdir/:$basename"
            convert $file $opth
        else
            set opth $bdir/:ang(string replace "$dir" "" "$file")
            mkdir -p (path dirname "$opth")
            cp "$file" "$opth"
        end
        set clr g
        if test (math $i % 2) = 0
            set clr y
        end
        echo (sc $clr)$file "->" $opth
        set i (math $i + 1)
    end
end

set bdir $here/.build
